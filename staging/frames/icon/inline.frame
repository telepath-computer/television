---
title: Inline sizing
description: The point of the sizing rule — the same icon is placed in runs of text at three sizes, and never given a size of its own.
imports:
  - ../../lib/foundation.ts
style: |
  .runs {
    padding: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    align-items: flex-start;
  }
  .runs > :nth-child(1) { font-size: 12px; }
  .runs > :nth-child(2) { font-size: 16px; }
  .runs > :nth-child(3) { font-size: 28px; }
---
<div class="runs">
  {% for i in (1..3) %}
  <p>Pinned {% render '../../../specs/ui/foundation/icons/icon', name: 'pin' %} and checked {% render '../../../specs/ui/foundation/icons/icon', name: 'check' %} beside text</p>
  {% endfor %}
</div>
