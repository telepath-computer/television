---
title: Block sizing
description: The sized icons at the frame's own text size, so nothing around them is doing the sizing — the attribute is.
imports:
  - ../../lib/foundation.ts
data:
  sizes: [sm, md, lg, xl]
style: |
  .sizes {
    padding: var(--space-16);
    display: flex;
    align-items: center;
    gap: var(--space-24);
  }
  .named {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .named > small {
    font-size: 11px;
    color: var(--color-text-muted);
  }
---
<div class="sizes">
  {% for size in sizes %}
  <div class="named">{% render '../../../specs/ui/foundation/icons/icon', name: 'settings', size: size %}<small>{{ size }}</small></div>
  {% endfor %}
</div>
