{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"]
  },
  "include": ["packages/**/*.ts", "packages/**/*.d.ts", "test/**/*.ts"]
}
