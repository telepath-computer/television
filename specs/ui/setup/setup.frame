---
title: Setup screen
params:
  state: { enum: [ready, connecting, connected, error], default: ready, description: "ready: waiting for a link; connecting: Connect was pressed and the app is waiting for the server; connected: the card shows a check and Connected; error: the connection failed" }
  link: { type: string, default: "http://100.101.102.103:32848/?token=3f9c2a7e", description: "the link in the step 2 field while connecting, connected, and after an error" }
  error: { type: string, default: "Couldn't reach http://100.101.102.103:32848 — is the server running?", description: "the failure's message, shown in the error state" }
data:
  prompt: "Read the Television admin guide at https://television.run/install.md and help me get Television installed. I'm on the desktop app connect screen."
style: |
  /* The screen: the wallpaper, blurred, filling the window, with the frame
     centred on it. */
  .setup-screen {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    padding: var(--space-32);
    overflow: hidden;
    /* The desktop app's window has no title bar, so the window is dragged
       by this background; the card itself is not a drag area. */
    -webkit-app-region: drag;
  }

  /* Oversized past the window so the blur doesn't fade at the edges. */
  .setup-wallpaper {
    position: absolute;
    inset: calc(-1 * var(--space-48));
    z-index: -1;
    background: var(--app-wallpaper);
    filter: blur(24px);
  }

  .setup-window {
    width: min(640px, 100%);
    -webkit-app-region: no-drag;
  }

  /* The steps and the Connected confirmation share one cell, so the frame
     keeps its size when the steps fade out. */
  .setup-body {
    display: grid;
  }

  .setup-body > * {
    grid-area: 1 / 1;
    transition: opacity 250ms ease;
  }

  .setup-done {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-16);
    opacity: 0;
    pointer-events: none;
  }

  .setup-screen[data-state="connected"] .setup-document {
    opacity: 0;
    pointer-events: none;
  }

  .setup-screen[data-state="connected"] .setup-done {
    opacity: 1;
  }

  .setup-done-mark {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    box-sizing: border-box;
    border: 2px solid var(--color-success);
    color: var(--color-success);
  }

  .setup-done p {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
  }

  /* The document: reading text one step above the prose size. */
  .setup-document {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    padding: var(--space-48);
    font-size: var(--text-lg);
  }

  .setup-document h1,
  .setup-document h2,
  .setup-document p,
  .setup-steps {
    margin: 0;
  }

  .setup-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  /* A quiet note under the introduction. Its links keep the note's colour. */
  .setup-note {
    font-size: var(--text-md);
    color: var(--color-text-muted);
  }

  .setup-note a {
    color: inherit;
  }

  .setup-document h1 {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
  }

  /* The Television logo, sized to the heading it sits in. */
  .setup-logo {
    width: 1em;
    height: 1em;
    margin: 0 0.05em;
    vertical-align: -0.14em;
  }

  /* The steps: numbered markers joined by a line down the left. */
  .setup-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    padding: 0;
    list-style: none;
  }

  .setup-step {
    position: relative;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: var(--space-16);
  }

  .setup-step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 13px;
    top: 36px;
    bottom: calc(-1 * var(--space-32) + var(--space-8));
    width: 2px;
    border-radius: 1px;
    background: var(--color-border);
  }

  /* Both markers are always at full strength: the numbers show the usual
     order, and nothing tracks a current step. */
  .setup-marker {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    box-sizing: border-box;
    border: 1.5px solid var(--color-primary);
    background: var(--color-primary);
    color: var(--color-primary-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }

  .setup-step-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-top: 3px;
  }

  .setup-document h2 {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
  }

  /* The prompt card, tilted slightly; one press selects the whole prompt. */
  .setup-prompt {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding: var(--space-16);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface-muted);
    box-shadow: var(--shadow-md);
    transform: rotate(-1deg);
  }

  .setup-prompt p {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--text-md);
    line-height: 1.5;
    overflow-wrap: break-word;
    user-select: all;
  }

  .setup-prompt-actions {
    flex: none;
  }

  .setup-link {
    display: flex;
    gap: var(--space-8);
  }

  .setup-link input {
    flex: 1;
    min-width: 0;
  }

  /* Connect's idle and connecting faces share one grid cell, so the button
     keeps the wider face's width. */
  .setup-submit {
    display: inline-grid;
  }

  .setup-submit > span {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    visibility: hidden;
  }

  .setup-screen:is([data-state="ready"], [data-state="error"]) .setup-submit-idle,
  .setup-screen:is([data-state="connecting"], [data-state="connected"]) .setup-submit-busy {
    visibility: visible;
  }

  .setup-hint code {
    font-family: var(--font-mono);
    font-size: var(--text-md);
  }

  @media (prefers-reduced-motion: reduce) {
    .setup-body > * {
      transition: none;
    }
  }
---
{% capture setup %}
<div class="setup-body">
  <div class="setup-document" text-display="prose"{% if state == 'connected' %} inert{% endif %}>
    <div class="setup-header">
      <h1>Let’s connect your <svg class="setup-logo" viewBox="0 0 55 55" aria-hidden="true"><defs><linearGradient id="tv-logo-shell" x1="27.5" y1="1.45" x2="27.5" y2="53.55" gradientUnits="userSpaceOnUse"><stop offset="0"/><stop offset="1" stop-color="#262626"/></linearGradient><clipPath id="tv-logo-screen"><path d="M14.2 7.7h26.6c3.15 0 5.7 2.66 5.7 5.94v27.72c0 3.28-2.55 5.94-5.7 5.94H14.2c-3.15 0-5.7-2.66-5.7-5.94V13.64c0-3.28 2.55-5.94 5.7-5.94Z"/></clipPath></defs><path fill="url(#tv-logo-shell)" d="M12.5 1.45h30c5.47 0 10.48 4.46 10.89 9.98.73 10.7.73 21.44 0 32.13-.41 5.52-5.42 9.98-10.89 9.98h-30c-5.47 0-10.48-4.46-10.89-9.98-.73-10.7-.73-21.44 0-32.13C2.02 5.91 7.03 1.45 12.5 1.45Z"/><g clip-path="url(#tv-logo-screen)"><rect fill="#fff" x="8.5" y="7.7" width="38" height="39.6" rx="5.7"/><path fill="#38c428" d="M27.5 48.78V6.71h-9.98v42.07h9.98Z"/><path fill="#ff01d0" d="M27.5 6.71v42.07h9.97V6.71H27.5Z"/><path fill="#40d2b3" d="M22.75 48.29c-3.8-18.22-1.58-34.98 0-41.08H10.87v41.08c3.96.33 11.88.79 11.88 0Z"/><path fill="#d24043" d="M32.25 7.21c3.8 18.22 1.58 34.98 0 41.08h11.88V7.21c-3.96-.33-11.88-.79-11.88 0Z"/><path fill="#ffcd27" d="M15.62 47.3c-5.7-17.42-2.38-33.66 0-39.6H7.07v39.6s9.03.49 8.55 0Z"/><path fill="#0015ff" d="M38.92 6.93c5.69 17.76 2.37 34.31 0 40.36h8.53V6.93s-9.01-.5-8.53 0Z"/></g><path fill="none" stroke="#fff" stroke-width="3" d="M14.2 8.74h26.6c2.56 0 5.25 2.06 5.8 4.64 1.89 9.31 1.89 18.91 0 28.23-.55 2.58-3.25 4.64-5.8 4.64H14.2c-2.56 0-5.25-2.06-5.8-4.64-1.89-9.31-1.89-18.91 0-28.23.55-2.58 3.25-4.64 5.8-4.64Z"/></svg> Television</h1>
      <p>Television runs alongside your agent, which needs to be running on macOS or Linux. Ask your agent to help you get connected, then paste the link it gives you.</p>
      <p class="setup-note">Don’t have an agent yet? Try
        <a href="https://hermes-agent.nousresearch.com/" target="_blank" rel="noopener noreferrer">Hermes</a>,
        <a href="https://openclaw.ai/" target="_blank" rel="noopener noreferrer">OpenClaw</a>,
        <a href="https://pi.dev/" target="_blank" rel="noopener noreferrer">Pi</a>,
        <a href="https://claude.com/product/claude-code" target="_blank" rel="noopener noreferrer">Claude Code</a>, or
        <a href="https://chatgpt.com/codex/" target="_blank" rel="noopener noreferrer">Codex</a>.</p>
    </div>
    <ol class="setup-steps">
      <li class="setup-step">
        <span class="setup-marker">1</span>
        <div class="setup-step-body">
          <h2>Give your agent this prompt</h2>
          <div class="setup-prompt">
            <p>{{ prompt }}</p>
            <div class="setup-prompt-actions">
              {% render '../app/copy-button/copy-button', label: 'Copy', prompt: prompt, size: 'default' %}
            </div>
          </div>
        </div>
      </li>
      <li class="setup-step">
        <span class="setup-marker">2</span>
        <div class="setup-step-body">
          <h2>Paste the link from your agent</h2>
          <form class="setup-link">
            <input type="text" data-size="lg" placeholder="Paste link here" aria-label="Link from your agent" required{% if state == 'connecting' or state == 'connected' %} value="{{ link }}" disabled{% endif %}{% if state == 'error' %} value="{{ link }}" aria-invalid="true" aria-describedby="setup-link-error"{% endif %}>
            <button intent="primary" size="lg" class="setup-submit"{% if state == 'connecting' or state == 'connected' %} disabled{% endif %}>
              <span class="setup-submit-idle">Connect</span>
              <span class="setup-submit-busy">{% render '../foundation/icons/icon', name: 'spinner', spinning: true %}Connecting…</span>
            </button>
          </form>
          {% if state == 'error' %}
          <p class="tv-error" id="setup-link-error">{{ error }}</p>
          {% else %}
          <p class="setup-hint">The link looks like <code>http://…:32848/?token=…</code></p>
          {% endif %}
        </div>
      </li>
    </ol>
  </div>
  <div class="setup-done"{% unless state == 'connected' %} aria-hidden="true"{% endunless %}>
    <span class="setup-done-mark">{% render '../foundation/icons/icon', name: 'check', size: 'lg' %}</span>
    <p>Connected</p>
  </div>
</div>
{% endcapture %}
<div class="setup-screen" data-state="{{ state }}">
  <div class="setup-wallpaper" aria-hidden="true"></div>
  <div class="setup-window">
    {% render '../app/artifact-frame/artifact-frame', title: 'Connect to Television', body: setup, menu: false %}
  </div>
</div>
