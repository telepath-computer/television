---
title: System modal
params:
  state:
    enum: [connecting, disconnected, unauthorized, needs-upgrade, error]
    default: unauthorized
    description: the modal's state
  server_url:
    type: string
    description: the server the connect was to, shown while error
  context:
    enum: [browser, desktop, local]
    default: browser
    description: "where the dialog shows: the server's interface in a browser; the server's interface in the desktop app; or the desktop app's local page, which alone offers Disconnect from Server as a button"
  drag_strip:
    type: boolean
    default: false
    description: "the desktop window's 36px drag strip across the top; the desktop app shows it where the interface's own drag handle cannot be reached"
  seconds:
    type: number
    description: "seconds until the next reconnection attempt, shown while disconnected or error; absent, an attempt is in flight"
  upgrade_instructions:
    description: the selected upgrade instructions, passed to the gate while needs-upgrade; markdown pipeline output (sanitized), placed verbatim
    default: "<h1>Desktop app update required</h1><p>This version of the Television desktop app does not work with this server and needs to be updated. <a href=\"https://dl.todesktop.com/260923p52umxx/mac/dmg/arm64\" target=\"_blank\" rel=\"noopener noreferrer\">Download the latest version for Mac</a> and install it.</p>"
  upgrade_restart:
    enum: [absent, ready, restarting]
    default: absent
    description: the gate's restart button, passed to the gate while needs-upgrade
imports:
  - content: ./content.yml
style: |
  /* The system modal's standard interior — icon, title, supporting line,
     at a fixed width. [[ui/app/dialog/index.md]] owns the panel and the
     backdrop; what is on the panel is this surface's. */
  .system-modal {
    width: min(400px, 90vw);
    padding: var(--space-32) var(--space-24);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    text-align: center;
  }

  .system-modal h2 {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
  }

  .system-modal p:not(.tv-error) {
    color: var(--color-text-muted);
  }

  /* The error state's server line: the address as an address. */
  .system-modal .server-url {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .system-modal .system-modal-disconnect {
    margin-top: var(--space-8);
  }

  /* The desktop window has no title bar: where nothing behind the dialog
     offers a drag handle, this strip across the top moves the window. */
  .window-drag-strip {
    position: fixed;
    inset: 0 0 auto 0;
    height: 36px;
  }
---
{% capture drag_region %}{% if drag_strip %}<div class="window-drag-strip" electron-draggable aria-hidden="true"></div>{% endif %}{% endcapture %}
{% capture disconnect_button %}<button intent="danger" class="system-modal-disconnect">{{ content.disconnect }}</button>{% endcapture %}
{% if seconds %}{% assign seconds_placeholder = "{{ seconds }}" %}{% assign reconnect_line = content.reconnecting | replace: seconds_placeholder, seconds %}{% else %}{% assign reconnect_line = content.reconnecting_now %}{% endif %}
{% if state == "connecting" %}
{% capture body %}<div class="system-modal">{% render '../../foundation/icons/icon', name: 'spinner', size: 'xl', spinning: true %}<h2>{{ content.connecting_title }}</h2></div>{% endcapture %}
{% render '../dialog/dialog', content: body, top_layer_content: drag_region %}
{% endif %}
{% if state == "disconnected" %}
{% capture body %}<div class="system-modal">{% render '../../foundation/icons/icon', name: 'spinner', size: 'xl', spinning: true %}<h2>{{ content.disconnected_title }}</h2><p>{{ reconnect_line }}</p></div>{% endcapture %}
{% render '../dialog/dialog', content: body, top_layer_content: drag_region %}
{% endif %}
{% if state == "unauthorized" %}
{% capture body %}<div class="system-modal">{% render '../../foundation/icons/icon', name: 'locked', size: 'xl' %}<h2>{{ content.unauthorized_title }}</h2><p>{% if context == "local" %}{{ content.unauthorized_copy_local }}{% elsif context == "desktop" %}{{ content.unauthorized_copy_desktop }}{% else %}{{ content.unauthorized_copy_browser }}{% endif %}</p>{% if context == "local" %}{{ disconnect_button }}{% endif %}</div>{% endcapture %}
{% render '../dialog/dialog', content: body, top_layer_content: drag_region %}
{% endif %}
{% if state == "error" %}
{% capture body %}<div class="system-modal"><h2>{{ content.error_title }}</h2><p class="server-url">{{ server_url }}</p><p>{{ content.error_copy }} {{ reconnect_line }}</p>{% if context == "local" %}{{ disconnect_button }}{% endif %}</div>{% endcapture %}
{% render '../dialog/dialog', content: body, top_layer_content: drag_region %}
{% endif %}
{% if state == "needs-upgrade" %}
{% render '../desktop-upgrade-gate/desktop-upgrade-gate', body: upgrade_instructions, restart: upgrade_restart, top_layer_content: drag_region %}
{% endif %}
