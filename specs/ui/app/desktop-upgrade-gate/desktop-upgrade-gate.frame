---
title: Desktop upgrade gate
params:
  body:
    description: the selected message; markdown pipeline output (sanitized), placed verbatim
    default: "<h1>Desktop app update required</h1><p>This version of the Television desktop app does not work with this server and needs to be updated. <a href=\"https://dl.todesktop.com/260923p52umxx/mac/dmg/arm64\" target=\"_blank\" rel=\"noopener noreferrer\">Download the latest version for Mac</a> and install it.</p>"
  restart:
    enum: [absent, ready, restarting]
    default: absent
    description: the restart button shown with the downloaded-update message; absent, none renders
  top_layer_content:
    description: optional window controls passed to the dialog outside its scrolling panel
imports:
  - content: ./content.yml
style: |
  /* The runtime mounts the gate directly under body, so its surface occupies
     the halted page while the fixed overlay and top-layer dialog paint it. */
  .desktop-upgrade-gate {
    position: fixed;
    inset: 0;
  }

  /* The instructions: a prose document at the reading width, scrolling within
     the panel when they outgrow the window — the backdrop never scrolls. */
  .upgrade-gate-body {
    box-sizing: border-box;
    width: min(560px, calc(100vw - 2 * var(--space-16)));
    max-height: calc(100vh - 2 * var(--space-16));
    overflow-y: auto;
    padding: var(--space-32) var(--space-24);
  }

  /* The reset zeroes block margins; this app-chrome markdown body needs its
     rhythm back locally. Canonical's prose treatment belongs to artifact
     documents and is intentionally not loaded here. */
  .upgrade-gate-body h1 {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    margin: 0 0 var(--space-12);
  }

  .upgrade-gate-body p {
    margin: 0 0 var(--space-12);
  }

  .upgrade-gate-body pre {
    margin: 0 0 var(--space-12);
    padding: var(--space-12);
    background: var(--color-surface-muted);
    border-radius: var(--control-radius);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .upgrade-gate-body :last-child {
    margin-bottom: 0;
  }

  /* The restart action, trailing, below the message. */
  .upgrade-gate-actions {
    display: flex;
    justify-content: flex-end;
    padding: 0 var(--space-24) var(--space-32);
  }
---
{% capture instructions %}<div class="upgrade-gate-body" data-testid="upgrade-gate-body">{{ body }}</div>{% if restart == 'ready' %}<div class="upgrade-gate-actions"><button intent="primary" class="upgrade-gate-restart">{{ content.restart_to_update }}</button></div>{% elsif restart == 'restarting' %}<div class="upgrade-gate-actions"><button intent="primary" class="upgrade-gate-restart" disabled>{{ content.restarting }}</button></div>{% endif %}{% endcapture %}
<div class="desktop-upgrade-gate">{% render '../dialog/dialog', content: instructions, top_layer_content: top_layer_content %}</div>
