---
title: Desktop setup, second draft
description: "Second draft, through to the arrival in the interface. One document in two layers: the Television interface at the bottom and the setup screen (specs/ui/setup/setup.frame) on top. Connect runs the arrival: Connected, then the setup frame and its blurred wallpaper zoom forward and fade to show the interface."
params:
  step: { enum: [copy, paste, connecting, connected, arrived], default: copy, description: "copy, paste, connecting and connected are the setup screen's states; arrived: the setup screen is gone and the interface is in use" }
  server_theme: { enum: [clouds, none, nord, swiss, tokyo-night], default: clouds, description: "the server's theme, which the interface wears; the blurred wallpaper is always Clouds" }
imports:
  - fresh: ./fresh-install.ts
  - clouds: ../../../specs/ui/themes/clouds/wallpaper.webp
  - clouds_dark: ../../../specs/ui/themes/clouds/wallpaper-dark.webp
style: |
  /* The window in two layers: the interface at the bottom and the setup
     screen on top. */
  .arrival {
    position: relative;
    isolation: isolate;
    height: 100vh;
    overflow: hidden;
  }

  .arrival-app,
  .arrival-setup {
    position: absolute;
    inset: 0;
    isolation: isolate;
  }

  .arrival-app {
    z-index: 0;
  }

  .arrival-app #app {
    height: 100%;
  }

  .arrival-setup {
    z-index: 1;
  }

  /* Staging only: the whole document wears the server's theme here, so the
     blurred wallpaper is pinned to the Clouds images the desktop app's own
     page would show. */
  .arrival .setup-wallpaper {
    background: var(--arrival-clouds) center / cover no-repeat;
  }

  :root[data-theme="dark"] .arrival .setup-wallpaper {
    background-image: var(--arrival-clouds-dark);
  }

  /* The arrival, after Connected: the setup frame zooms toward the viewer as
     it fades, and the blurred wallpaper follows, zooming and fading to show
     the interface beneath. Both ease in and out; the wallpaper starts as the
     frame is under way. */
  .arrival .setup-window {
    transition:
      transform 550ms cubic-bezier(0.65, 0, 0.35, 1),
      opacity 550ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .arrival[data-transition="leave"] .setup-window {
    transform: scale(1.12);
    opacity: 0;
  }

  .arrival .setup-wallpaper {
    transition:
      transform 1000ms cubic-bezier(0.65, 0, 0.35, 1) 200ms,
      opacity 1000ms cubic-bezier(0.65, 0, 0.35, 1) 200ms;
  }

  .arrival[data-transition="leave"] .setup-wallpaper {
    transform: scale(1.15);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .arrival .setup-window,
    .arrival .setup-wallpaper {
      transition: none;
    }
  }
script: |
  // Prototype wiring (staging only) for the arrival. The setup screen's own
  // wiring is frames/lib/setup.ts. Connect stands in for a server:
  // connecting, then Connected, then the setup frame and wallpaper zoom
  // forward and fade to show the interface, which is left in use. At rest
  // the markup matches the frame's render for the resulting step.
  import { onboardingChannel } from "../../lib/onboarding-channel.ts";
  import { setupPrototype, showConnected } from "../../lib/setup.ts";
  import appMeasures from "../../../specs/ui/app/measures.yml";

  // Staging's stand-in for how long a server takes to answer the connect.
  const SIMULATED_CONNECT_MS = 1500;

  // Staging's stand-in for the interface loading underneath while Connected
  // shows; the real hold lasts until the interface is ready.
  const CONNECTED_HOLD_MS = 1000;

  const reducedMotion = (): boolean => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** Resolve when the element's opacity transition ends, or at once without motion. */
  const opacityTransitionEnd = (element: HTMLElement): Promise<void> =>
    new Promise((resolve) => {
      if (reducedMotion()) {
        resolve();
        return;
      }
      const onEnd = (event: TransitionEvent): void => {
        if (event.target !== element || event.propertyName !== "opacity") return;
        element.removeEventListener("transitionend", onEnd);
        resolve();
      };
      element.addEventListener("transitionend", onEnd);
    });

  // The interface layer: the client's sidebar width, and the TV Guide
  // channel's page sizes and tab selection.
  const wireInterface = (): (() => void) => {
    const app = document.querySelector<HTMLElement>(".arrival-app");
    if (!app) return () => {};
    app.style.setProperty("--sidebar-width", `${appMeasures.sidebar.default_width_px}px`);
    const disposeChannel = onboardingChannel(app);
    return () => {
      disposeChannel();
      app.style.removeProperty("--sidebar-width");
    };
  };

  // The setup layer: the setup screen's own wiring (frames/lib/setup.ts),
  // with Connect running the arrival.
  const wireSetup = (): (() => void) => {
    const root = document.querySelector<HTMLElement>(".arrival");
    const app = root?.querySelector<HTMLElement>(".arrival-app");
    const layer = root?.querySelector<HTMLElement>(".arrival-setup");
    const screen = layer?.querySelector<HTMLElement>(".setup-screen");
    const wallpaper = layer?.querySelector<HTMLElement>(".setup-wallpaper");
    if (!root || !app || !layer || !screen || !wallpaper) return () => {};
    let alive = true;
    const pending: ReturnType<typeof setTimeout>[] = [];
    const wait = (ms: number): Promise<void> =>
      new Promise((resolve) => {
        pending.push(setTimeout(resolve, ms));
      });

    const arrive = async (): Promise<void> => {
      root.dataset.step = "connecting";
      await wait(SIMULATED_CONNECT_MS);
      if (!alive) return;
      showConnected(screen);
      root.dataset.step = "connected";
      await wait(CONNECTED_HOLD_MS);
      if (!alive) return;
      root.dataset.transition = "leave";
      await opacityTransitionEnd(wallpaper);
      if (!alive) return;
      delete root.dataset.transition;
      root.dataset.step = "arrived";
      layer.remove();
      app.inert = false;
      app.removeAttribute("aria-hidden");
    };

    const disposeScreen = setupPrototype(screen, { onConnect: () => void arrive() });
    return () => {
      alive = false;
      pending.forEach(clearTimeout);
      disposeScreen();
    };
  };

  const wire = (): (() => void) => {
    const disposeInterface = wireInterface();
    const disposeSetup = wireSetup();
    return () => {
      disposeSetup();
      disposeInterface();
    };
  };

  let dispose = wire();
  window.addEventListener("frameset:rendered", () => {
    dispose();
    dispose = wire();
  });
---
<div class="arrival" data-staging-theme="{{ server_theme }}" data-step="{{ step }}" style="--arrival-clouds: url('{{ clouds }}'); --arrival-clouds-dark: url('{{ clouds_dark }}')">
  <div class="arrival-app" data-channel="{{ fresh.selected }}"{% unless step == 'arrived' %} inert aria-hidden="true"{% endunless %}>
    {% render '../../../specs/ui/app/app', channels: fresh.channels, selected: fresh.selected, selected_tab: fresh.selected_tab, show_notice: false %}
  </div>
  {% unless step == 'arrived' %}
  <div class="arrival-setup">
    {% render '../../../specs/ui/setup/setup', step: step %}
  </div>
  {% endunless %}
</div>
