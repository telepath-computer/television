<h2>Roles</h2>
<div class="tokens">
  <div class="token"><div class="sw" style="background: var(--color-surface)"></div><span class="name">--color-surface</span><span class="value">white</span></div>
  <div class="token"><div class="sw" style="background: var(--color-surface-muted)"></div><span class="name">--color-surface-muted</span><span class="value">var(--neutral-100)</span></div>
  <div class="token"><div class="sw" style="background: var(--color-text)"></div><span class="name">--color-text</span><span class="value">var(--neutral-900)</span></div>
  <div class="token"><div class="sw" style="background: var(--color-text-muted)"></div><span class="name">--color-text-muted</span><span class="value">var(--neutral-500)</span></div>
  <div class="token"><div class="sw" style="background: var(--color-text-reversed)"></div><span class="name">--color-text-reversed</span><span class="value">white</span></div>
  <div class="token"><div class="sw" style="background: var(--color-border)"></div><span class="name">--color-border</span><span class="value">12% light / 18% dark text tint</span></div>
  <div class="token"><div class="sw" style="background: var(--control-background)"></div><span class="name">--control-background</span><span class="value">var(--color-surface)</span></div>
  <div class="token"><div class="sw" style="background: var(--color-danger)"></div><span class="name">--color-danger</span><span class="value">var(--red-500)</span></div>
  <div class="token"><div class="sw" style="background: var(--tint-danger)"></div><span class="name">--tint-danger</span><span class="value">oklch(from var(--color-danger) l c h / var(--alpha-10))</span></div>
  <div class="token"><div class="sw" style="background: var(--color-alert)"></div><span class="name">--color-alert</span><span class="value">var(--yellow-500)</span></div>
  <div class="token"><div class="sw" style="background: var(--tint-alert)"></div><span class="name">--tint-alert</span><span class="value">oklch(from var(--color-alert) l c h / var(--alpha-10))</span></div>
  <div class="token"><div class="sw" style="background: var(--color-success)"></div><span class="name">--color-success</span><span class="value">var(--green-500)</span></div>
  <div class="token"><div class="sw" style="background: var(--tint-success)"></div><span class="name">--tint-success</span><span class="value">oklch(from var(--color-success) l c h / var(--alpha-10))</span></div>
  <div class="token"><div class="sw" style="background: var(--color-primary)"></div><span class="name">--color-primary</span><span class="value">var(--accent-500)</span></div>
  <div class="token"><div class="sw" style="background: var(--tint-primary)"></div><span class="name">--tint-primary</span><span class="value">oklch(from var(--color-primary) l c h / var(--alpha-10))</span></div>
  <div class="token"><div class="sw" style="background: var(--color-primary-text)"></div><span class="name">--color-primary-text</span><span class="value">computed against --color-primary: dark ink above --contrast-flip, near-white below</span></div>
  <div class="token"><div class="sw" style="background: var(--color-link)"></div><span class="name">--color-link</span><span class="value">currentColor — follows surrounding text</span></div>
  <div class="token"><div class="sw" style="background: var(--color-overlay)"></div><span class="name">--color-overlay</span><span class="value">oklch(from var(--neutral-950) l c h / var(--alpha-40))</span></div>
</div>
<h2>State machinery</h2>
<div class="tokens">
  <div class="token"><div class="sw checker"><div style="width:100%;height:100%;border-radius:4px;background: var(--tint-hover)"></div></div><span class="name">--hover-mix</span><span class="value">62.5% light / 66.6666667% dark — progress from resting to active</span></div>
  <div class="token"><div class="sw checker"><div style="width:100%;height:100%;border-radius:4px;background: oklch(from var(--color-text) l c h / var(--alpha-active))"></div></div><span class="name">--alpha-active</span><span class="value">8% light / 12% dark — default active strength</span></div>
  <div class="token"><div class="sw" style="background: linear-gradient(to right, black 35%, white 35%)"></div><span class="name">--state-flip</span><span class="value">0.35 — a fill lighter than this darkens in its states; a darker one lightens</span></div>
  <div class="token"><div class="sw" style="background: linear-gradient(to right, black 66%, white 66%)"></div><span class="name">--contrast-flip</span><span class="value">0.66 — a fill lighter than this wears dark text; a darker one wears reversed type</span></div>
</div>
<h2>Tints</h2>
<div class="tokens">
  <div class="token"><div class="sw checker"><div style="width:100%;height:100%;border-radius:4px;background: var(--tint-hover)"></div></div><span class="name">--tint-hover</span><span class="value">transparent mixed with --tint-active at --hover-mix</span></div>
  <div class="token"><div class="sw checker"><div style="width:100%;height:100%;border-radius:4px;background: var(--tint-active)"></div></div><span class="name">--tint-active</span><span class="value">text pigment at --alpha-active</span></div>
  <div class="token"><div class="sw checker"><div style="width:100%;height:100%;border-radius:4px;background: var(--tint-danger-hover)"></div></div><span class="name">--tint-danger-hover</span><span class="value">transparent mixed with --tint-danger-active at --hover-mix</span></div>
  <div class="token"><div class="sw checker"><div style="width:100%;height:100%;border-radius:4px;background: var(--tint-danger-active)"></div></div><span class="name">--tint-danger-active</span><span class="value">danger pigment at --alpha-active</span></div>
  <div class="token"><div class="sw checker"><div style="width:100%;height:100%;border-radius:4px;background: var(--tint-alert-hover)"></div></div><span class="name">--tint-alert-hover</span><span class="value">transparent mixed with --tint-alert-active at --hover-mix</span></div>
  <div class="token"><div class="sw checker"><div style="width:100%;height:100%;border-radius:4px;background: var(--tint-alert-active)"></div></div><span class="name">--tint-alert-active</span><span class="value">alert pigment at --alpha-active</span></div>
</div>
<h2>State fills</h2>
<div class="scale-label">control</div>
<div class="row">
  <div style="background: var(--control-background)"></div>
  <div style="background: var(--control-background-hover)"></div>
  <div style="background: var(--control-background-active)"></div>
</div>
<div class="steps"><span>rest</span><span>hover</span><span>active</span></div>
<div class="scale-label">primary</div>
<div class="row">
  <div style="background: var(--color-primary)"></div>
  <div style="background: var(--color-primary-hover)"></div>
  <div style="background: var(--color-primary-active)"></div>
</div>
<div class="steps"><span>rest</span><span>hover</span><span>active</span></div>
<div class="scale-label">danger</div>
<div class="row">
  <div style="background: var(--color-danger)"></div>
  <div style="background: var(--color-danger-hover)"></div>
  <div style="background: var(--color-danger-active)"></div>
</div>
<div class="steps"><span>rest</span><span>hover</span><span>active</span></div>
<div class="scale-label">alert</div>
<div class="row">
  <div style="background: var(--color-alert)"></div>
  <div style="background: var(--color-alert-hover)"></div>
  <div style="background: var(--color-alert-active)"></div>
</div>
<div class="steps"><span>rest</span><span>hover</span><span>active</span></div>
</main>
