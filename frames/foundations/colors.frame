---
title: Colors
params:
  appearance: { enum: [light, dark], default: light }
  theme: { enum: [none, clouds, nord, swiss, tokyo-night], default: none }
style: |
  main {
    /* self-grounded: the theme control must paint its own world */
    padding: 32px 40px 64px;
    max-width: 1040px;
    min-height: 100vh;
    box-sizing: border-box;
    background: var(--color-surface);
    color: var(--color-text);
  }
  h1 { font-size: var(--text-lg); margin: 0 0 16px; }
  h2 {
    font-size: var(--text-sm); text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--color-text-muted); margin: 28px 0 8px;
  }
  .scale-label { font-family: var(--font-mono); font-size: 11px; color: var(--color-text-muted); margin: 10px 0 2px; }
  .row { display: flex; }
  .row > div { flex: 1; height: 44px; }
  .row > div:first-child { border-radius: 6px 0 0 6px; }
  .row > div:last-child { border-radius: 0 6px 6px 0; }
  .steps { display: flex; margin-bottom: 4px; }
  .steps span { flex: 1; text-align: center; font-family: var(--font-mono); font-size: 10px; color: var(--color-text-muted); }
  .checker { background: repeating-conic-gradient(oklch(0 0 0 / 8%) 0% 25%, transparent 0% 50%) 0 0 / 16px 16px; border-radius: 6px; }
  .token { display: flex; align-items: center; gap: 12px; padding: 3px 0; font-family: var(--font-mono); font-size: 12px; }
  .token .sw { width: 36px; height: 20px; border-radius: 4px; border: 1px solid oklch(0 0 0 / 10%); flex: none; }
  .token .name { min-width: 260px; }
  .token .name.pad { margin-left: 48px; }
  .token .value { color: var(--color-text-muted); }
  .slots { display: flex; gap: 12px; flex-wrap: wrap; }
  .slot { text-align: center; font-family: var(--font-mono); font-size: 11px; }
  .slot .sw { width: 56px; height: 56px; border-radius: var(--panel-radius); margin: 0 auto 4px; border: 1px solid oklch(0 0 0 / 8%); }
---
<main>
<!-- Static swatch boards for the foundation's color tokens. Regenerate the
     board markup when the token census changes; values shown are the light
     table's declared text, swatches render live in either mode. -->
<h1>Colors</h1>
<h2>Slots</h2>
<div class="slots">
  <div class="slot"><div class="sw" style="background: var(--neutral)"></div>--neutral</div>
  <div class="slot"><div class="sw" style="background: var(--red)"></div>--red</div>
  <div class="slot"><div class="sw" style="background: var(--orange)"></div>--orange</div>
  <div class="slot"><div class="sw" style="background: var(--yellow)"></div>--yellow</div>
  <div class="slot"><div class="sw" style="background: var(--green)"></div>--green</div>
  <div class="slot"><div class="sw" style="background: var(--cyan)"></div>--cyan</div>
  <div class="slot"><div class="sw" style="background: var(--blue)"></div>--blue</div>
  <div class="slot"><div class="sw" style="background: var(--purple)"></div>--purple</div>
  <div class="slot"><div class="sw" style="background: var(--pink)"></div>--pink</div>
  <div class="slot"><div class="sw" style="background: var(--accent)"></div>--accent</div>
</div>
<h2>Scales</h2>
<div class="scale-label">neutral</div>
<div class="row">
  <div style="background: var(--neutral-50)"></div>
  <div style="background: var(--neutral-100)"></div>
  <div style="background: var(--neutral-200)"></div>
  <div style="background: var(--neutral-300)"></div>
  <div style="background: var(--neutral-400)"></div>
  <div style="background: var(--neutral-500)"></div>
  <div style="background: var(--neutral-600)"></div>
  <div style="background: var(--neutral-700)"></div>
  <div style="background: var(--neutral-800)"></div>
  <div style="background: var(--neutral-900)"></div>
  <div style="background: var(--neutral-950)"></div>
</div>
<div class="steps"><span>50</span><span>100</span><span>200</span><span>300</span><span>400</span><span>500</span><span>600</span><span>700</span><span>800</span><span>900</span><span>950</span></div>
<div class="scale-label">red</div>
