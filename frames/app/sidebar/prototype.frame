---
title: Prototype
params:
  appearance: { enum: [light, dark], default: light }
  theme: { enum: [none, clouds, nord, swiss, tokyo-night], default: none }
style: |
  .canvas { min-height: 100vh; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 32px; }
  .stage { width: 260px; height: 660px; box-shadow: 0 0 0 1px oklch(0 0 0 / 0.08), 0 8px 24px oklch(0 0 0 / 0.06); }
  .stage .sidebar { min-height: 100%; height: 100%; }
script: |
  import { sidebarPrototype } from "../../lib/sidebar.ts";

  let cleanup: (() => void) | undefined;
  const wire = () => {
    cleanup?.();
    const stage = document.querySelector<HTMLElement>(".stage");
    if (stage) cleanup = sidebarPrototype(stage);
  };
  wire();
  window.addEventListener("frameset:rendered", wire);
---
<div class="canvas">
  <div class="stage">
{% render '../../../specs/ui/app/sidebar/sidebar' %}
  </div>
</div>
