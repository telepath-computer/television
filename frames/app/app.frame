---
title: App
params:
  appearance: { enum: [light, dark], default: light }
  theme: { enum: [none, clouds, nord, swiss, tokyo-night], default: none }
  shell: { enum: [desktop, web], default: desktop, description: "desktop stages the Electron window — rounded corners and the traffic lights the sidebar titlebar reserves space for; web is the bare document" }
  collapsed: { type: boolean, default: false, description: "the channel sidebar is collapsed" }
  switcher_open: { type: boolean, default: false, description: "the collapsed navbar's channel-switcher menu posed open" }
imports:
  - application: ../lib/app.ts
style: |
  .canvas { min-height: 100vh; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 32px; }
  .window {
    position: relative;
    width: 1100px;
    height: 720px;
    background: var(--color-surface);
    box-shadow: 0 0 0 1px oklch(0 0 0 / 0.08), 0 8px 24px oklch(0 0 0 / 0.06);
  }
  .window.desktop {
    /* The macOS window: rounded, clipping its contents like the real one. */
    border-radius: 10px;
    overflow: clip;
    box-shadow: 0 0 0 1px oklch(0 0 0 / 0.12), 0 18px 48px oklch(0 0 0 / 0.18);
  }
  .shell-host, .shell-host #app { height: 100%; }
  .window .sidebar { min-height: 100%; height: 100%; }
  /* Staged native traffic lights share the top band's centre. */
  .traffic-lights {
    position: absolute;
    top: calc((var(--app-bar-height) - 14px) / 2);
    left: 15px;
    display: flex;
    gap: 8px;
    /* Above #app, whose sheet gives it z-index 1. */
    z-index: 2;
  }
  .traffic-lights span {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.5px oklch(0 0 0 / 0.2);
  }
  .traffic-lights span:nth-child(1) { background: #ff5f57; }
  .traffic-lights span:nth-child(2) { background: #febc2e; }
  .traffic-lights span:nth-child(3) { background: #28c840; }
script: |
  import { appPrototype } from "../lib/app.ts";

  let cleanup: (() => void) | undefined;
  const wire = () => {
    cleanup?.();
    // The desktop pose is the electron shell: mirror the client's root marker
    // so the traffic-light reservation token resolves as it would in production.
    if (document.querySelector(".window.desktop")) {
      document.documentElement.setAttribute("data-platform", "electron");
    } else {
      document.documentElement.removeAttribute("data-platform");
    }
    const host = document.querySelector<HTMLElement>(".shell-host");
    if (host) cleanup = appPrototype(host);
  };
  wire();
  window.addEventListener("frameset:rendered", wire);
---
<div class="canvas">
  <div class="window{% if shell == 'desktop' %} desktop{% endif %}">
    {% if shell == 'desktop' %}<div class="traffic-lights" aria-hidden="true"><span></span><span></span><span></span></div>{% endif %}
    <div class="shell-host">
      {% render '../../specs/ui/app/app', channels: application.channels, show_notice: true, collapsed: collapsed, switcher_open: switcher_open %}
    </div>
  </div>
</div>
