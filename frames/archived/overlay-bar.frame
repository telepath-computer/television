---
title: Overlay bar
params:
  appearance: { enum: [light, dark], default: light }
  theme: { enum: [none, clouds, nord, swiss, tokyo-night], default: clouds }
  shell: { enum: [desktop, web], default: desktop }
  collapsed: { type: boolean, default: true, description: "the channel sidebar is collapsed; off shows it open, full-height, with its implied top bar" }
imports:
  - application: ../lib/app.ts
style: |
  .canvas { min-height: 100vh; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 32px; }
  .window {
    position: relative;
    width: 1100px;
    height: 720px;
    background: var(--color-surface);
    box-shadow: 0 0 0 1px oklch(0 0 0 / 0.08), 0 8px 24px oklch(0 0 0 / 0.06);
  }
  .window.desktop {
    border-radius: 10px;
    overflow: clip;
    box-shadow: 0 0 0 1px oklch(0 0 0 / 0.12), 0 18px 48px oklch(0 0 0 / 0.18);
  }
  .shell-host, .shell-host #app { height: 100%; }
  .traffic-lights { position: absolute; top: 12px; left: 12px; display: flex; gap: 8px; z-index: 2; }
  .traffic-lights span { width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 0.5px oklch(0 0 0 / 0.2); }
  .traffic-lights span:nth-child(1) { background: #ff5f57; }
  .traffic-lights span:nth-child(2) { background: #febc2e; }
  .traffic-lights span:nth-child(3) { background: #28c840; }

  /* Prototype: the whole bar is one long overlay — the frosted treatment on
     the bar itself, not per-control chips. Its bottom border carries the
     window's edge line; the expanded sidebar answers with an implied top bar
     of its own, closed by the same border so the edge runs unbroken. */
  .shell-host .top-bar {
    background: var(--wallpaper-overlay-background);
    backdrop-filter: blur(var(--wallpaper-overlay-blur));
    border-bottom: 1px solid var(--color-border);
  }

  /* Buttons sit nude on the bar: no chip ground, ordinary ghost states. */
  .shell-host .top-bar :is(.top-bar-controls, .top-bar-lead) > button[variant="ghost"]:not([intent]) {
    background: transparent;
    border: 0;
    outline: none;
    backdrop-filter: none;
  }
  .shell-host .top-bar :is(.top-bar-controls, .top-bar-lead) > button[variant="ghost"]:not([intent]):hover:not(:disabled) {
    background: var(--tint-hover);
  }
  .shell-host .top-bar :is(.top-bar-controls, .top-bar-lead) > button[variant="ghost"]:not([intent]):is(:active, [aria-expanded="true"]):not(:disabled) {
    background: var(--tint-active);
  }

  /* The tabs leave the top bar for a bottom bar over the stage. */
  .shell-host .top-bar > .tab-strip { display: none; }

  /* The bottom bar is implied: no ground, no edge — the tabs float on the
     wallpaper as they do in the top band today, just at the stage's foot. */
  .bottom-bar {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: var(--space-12);
    height: var(--app-bar-height);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-8);
  }

  /* The sidebar's implied top bar: its titlebar closes with the same border
     the main bar carries, so the edge runs across the whole window. */
  .shell-host .sidebar-titlebar {
    border-bottom-color: var(--color-border);
  }

  .shell-host .sidebar-body {
    padding-top: var(--space-8);
  }
script: |
  import appMeasures from "../../specs/ui/app/measures.yml";

  if (document.querySelector(".window.desktop")) {
    document.documentElement.setAttribute("data-platform", "electron");
  } else {
    document.documentElement.removeAttribute("data-platform");
  }
  // No rig here to play the client, so the pose seeds the width itself.
  document.querySelector(".shell-host")?.style.setProperty(
    "--sidebar-width",
    `${appMeasures.sidebar.default_width_px}px`,
  );
---
<div class="canvas">
  <div class="window{% if shell == 'desktop' %} desktop{% endif %}">
    {% if shell == 'desktop' %}<div class="traffic-lights" aria-hidden="true"><span></span><span></span><span></span></div>{% endif %}
    <div class="shell-host">
      {% render '../../specs/ui/app/app', channels: application.channels, selected: 'television', selected_tab: 'roadmap', show_notice: true, collapsed: collapsed %}
    </div>
    {% assign open_channel = application.channels | first %}
    <div class="bottom-bar">
      {% render '../../specs/ui/app/tab-strip/tab-strip', tabs: open_channel.tabs, selected: 'roadmap' %}
    </div>
  </div>
</div>
